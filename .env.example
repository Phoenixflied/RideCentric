# Copy this file to ".env" (same folder) and paste your AirLabs API key after the "=".
# Get a key at https://airlabs.co. The ".env" file is never committed to git.
FLIGHT_API_KEY=

# Sign-up on the website is off. Create logins with:  python add_user.py
# Only if you really want open self-registration, remove the "#" in the next line:
# ALLOW_SIGNUP=1
