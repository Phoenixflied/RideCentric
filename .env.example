# Copy this file to ".env" (same folder) and paste your AirLabs API key after the "=".
# Get a key at https://airlabs.co. The ".env" file is never committed to git.
FLIGHT_API_KEY=

# Sign-up on the website is off. Create logins with:  python add_user.py
# Only if you really want open self-registration, remove the "#" in the next line:
# ALLOW_SIGNUP=1

# --- Optional settings (the defaults suit a Dallas operation) --------------------------------------------
# Time zone of the manifests' times (the station). Dallas = America/Chicago.
# STATION_TZ=America/Chicago
# Airport the rides arrive at, used when a PDF file name does not start with it ("DFW SkyWest.pdf" already does).
# STATION_AIRPORT=DFW
# Each ride is deleted this many minutes after its arrival.
# PURGE_AFTER_MINUTES=60
# Check the manifests/ folder for new PDFs every N minutes (0 = only when "Scan folder" is pressed).
# AUTO_SCAN_MINUTES=5
# Flight-status API budget: requests per month (0 = unlimited) and how many hours before arrival live data starts.
# LIVE_MONTHLY_BUDGET=1000
# LIVE_WINDOW_HOURS=10
